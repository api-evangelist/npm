          "id": "49a11407-dc95-4f25-bea8-9504558dea55",
          "name": "List access tokens",
          "request": {
            "name": "List access tokens",
            "description": {
              "content": "Retrieves a list of the authenticated user's active npm access tokens. Token UUIDs are redacted in the response, but each token object includes a key attribute containing the hexadecimal SHA-512 hash of the token for identification purposes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "-",
                "npm",
                "v1",
                "tokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {

          "name": "Create an access token",
          "request": {
            "name": "Create an access token",
            "description": {
              "content": "Creates a new npm access token with customizable permissions, scope restrictions, expiration settings, and CIDR IP range limitations. The response includes the full token value, which is only returned once and cannot be retrieved again.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "-",
                "npm",
                "v1",
                "tokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "One-time password for accounts with two-factor authentication enabled.",
                "key": "npm-otp",
                "value": "<string>"
              },

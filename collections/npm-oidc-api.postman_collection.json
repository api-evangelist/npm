  "item": [
    {
      "id": "e61ad87e-e4dc-4d91-8d63-bb541d24247e",
      "name": "OIDC",
      "description": {
        "content": "OpenID Connect token exchange for trusted publishing. Exchange OIDC identity tokens from supported CI/CD providers for short-lived npm registry access tokens.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "29601a70-9f96-4687-bde6-f609277f5443",
          "name": "Exchange an OIDC token for an npm token",
          "request": {
            "name": "Exchange an OIDC token for an npm token",
            "description": {
              "content": "Exchanges a valid OIDC identity token from a supported CI/CD provider for a short-lived npm registry access token. The OIDC token must be provided as a Bearer token in the Authorization header. The provider must be pre-configured as a trusted publisher for the target package.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "-",
                "npm",
                "v1",
                "security",
                "oidc",
                "tokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"package\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "8c551c5d-7507-4c9b-99b5-2ffa789d97ec",

          "id": "2f53aeba-4551-428a-baf4-71e7c3bab6d1",
          "name": "Get a specific package version",
          "request": {
            "name": "Get a specific package version",
            "description": {
              "content": "Retrieves metadata for a specific version of a package. The version can be a valid semver string or the literal string \"latest\" to retrieve the version pointed to by the latest dist-tag. Returns the version-specific manifest including dependencies, scripts, and distribution information.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":package",
                ":version"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "package",
                  "description": "(Required) The name of the package. For scoped packages, use URL encoding (e.g., @scope%2Fpackage)."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "version",
                  "description": "(Required) A valid semver version string, or the literal string \"latest\" to resolve the current latest dist-tag."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null

{
  "opencollection": "1.0.0",
  "info": {
    "name": "npm Hooks Downloads Registry API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Registry",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get registry metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://registry.npmjs.org/"
          },
          "docs": "Returns metadata about the npm registry, including document counts, storage sizes, and instance information. This endpoint follows the CouchDB database information convention."
        }
      ]
    }
  ],
  "bundled": true
}
                    "{{baseUrl}}"
                  ],
                  "path": [
                    ":package",
                    ":version"
                  ],
                  "variable": [
                    {
                      "id": "c8c4a603-932e-4953-8ad7-5ca9f533907c",
                      "key": "package",
                      "value": "<string>",
                      "description": "(Required) The name of the package. For scoped packages, use URL encoding (e.g., @scope%2Fpackage)."
                    },
                    {
                      "id": "fdc9ccf1-4742-479b-a200-7a3162626a3a",
                      "key": "version",
                      "value": "<string>",
                      "description": "(Required) A valid semver version string, or the literal string \"latest\" to resolve the current latest dist-tag."
                    }
                  ]
                },
                "description": "Retrieves metadata for a specific version of a package. The version can be a valid semver string or the literal string \"latest\" to retrieve the version pointed to by the latest dist-tag. Returns the version-specific manifest including dependencies, scripts, and distribution information."
